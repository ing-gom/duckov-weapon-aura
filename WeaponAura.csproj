<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>true</ImplicitUsings>

    <!-- DLL filename setting -->
    <AssemblyName>WeaponAura</AssemblyName>

    <!-- Mod name setting (Ducky SDK required) -->
    <ModName>WeaponAura</ModName>

    <!-- Build setting: do not treat warnings as errors -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>false</MSBuildTreatWarningsAsErrors>

    <!-- AssemblyInfo.cs를 수동으로 관리하므로 자동 생성 비활성화 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ducky.Sdk" Version="0.1.5" />
    <PackageReference Include="Lib.Harmony" Version="2.4.1" />
  </ItemGroup>

</Project>
